# ============================================================
# Saga X Agent Desk — environment template
# ============================================================
# Copy to .env and fill in. .env is gitignored; this file is not.
# NEVER put a real secret in this file.
#
#   cp .env.example .env
#
# SPLIT: vars marked [BACKEND] must exist ONLY on Railway.
# Anything shipped to the browser via Vercel is public — a key
# placed there is readable by anyone who opens devtools.
# ============================================================

# ── OpenAI API (agent brains) ───────────────────────────────
# [BACKEND ONLY] Never expose to the frontend. If this key reaches a
# Vercel client bundle, anyone with devtools spends your budget.
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_ORG_ID=
# Per 1M tokens (input/output), Sept 2026:
#   gpt-5.6-sol    $4.00 / $20.00  — strongest; best for invoices + reasoning
#   gpt-5.6-terra  $2.00 / $12.00  — mid; the cost step-down lever
#   gpt-5.6-luna   $0.20 / $1.20   — cheapest; weakest at tool calling
OPENAI_MODEL=gpt-5.6-sol
# Reasoning effort: minimal | low | medium | high | max
# Keep low for routine work (list tasks, flip a status); raise for planning.
OPENAI_REASONING_EFFORT=low
# Hard spend ceiling. Backend refuses new calls past this for the month.
MONTHLY_CAP_USD=15

# ── Supabase (database) ─────────────────────────────────────
# URL and ANON key are safe in the browser — they rely on Row Level
# Security. SERVICE_ROLE bypasses RLS entirely: backend only, always.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # [BACKEND ONLY] server.py uses this for all desk.* access
# Not needed — server.py reaches Postgres through PostgREST, not a
# direct connection. Left blank on purpose; do not reset the DB
# password on our account.
SUPABASE_DB_PASSWORD=
# PostgREST needs this header to address the desk schema:
#   Accept-Profile: desk   (reads)   /   Content-Profile: desk  (writes)
SUPABASE_SCHEMA=desk

# ── Cloudflare (DNS for desk.sagaxventures.com) ─────────────
CLOUDFLARE_API_TOKEN=               # [BACKEND ONLY]
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ── GitHub (repo) ───────────────────────────────────────────
GITHUB_TOKEN=                       # [BACKEND ONLY]
GITHUB_REPO=asri2703/saga-x-agent-desk

# ── Buffer (social publishing) — ON HOLD ────────────────────
# Personal API key beta only; Buffer stopped issuing new OAuth
# client_ids in 2019. Request access, then generate from
# https://publish.buffer.com/settings/api
BUFFER_API_KEY=                     # [BACKEND ONLY]

# ── Telegram (notifications — works before HTTPS lands) ─────
TG_BOT_TOKEN=                       # [BACKEND ONLY]
TG_WEBHOOK_SECRET=                  # python -c "import secrets;print(secrets.token_urlsafe(24))"
TG_ALLOWED_CHAT_IDS=                # comma-separated; only these may command the desk

# ── Web Push (VAPID) — after HTTPS is live ──────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                  # [BACKEND ONLY]
VAPID_SUBJECT=mailto:

# ── Server ──────────────────────────────────────────────────
# 127.0.0.1 locally. Railway sets PORT itself and needs 0.0.0.0.
HOST=127.0.0.1
PORT=8080
AUTH_REQUIRED=0
POST_TOKEN=
# Same-origin: server.py serves both the page and the API, so no CORS is needed.
# Drop the existing Access-Control-Allow-Origin: * header rather than widening this.
CORS_ALLOWED_ORIGINS=

# ── Scheduler ───────────────────────────────────────────────
# Single global off switch. Assignments also have their own `enabled`
# flag, and the monthly cap refuses regardless of both.
SCHEDULER_ENABLED=1

# ── VPS (Google Cloud) ──────────────────────────────────────
# [BACKEND ONLY] Needed to deploy. Not used by the running app.
GCP_PROJECT_ID=
# [BACKEND ONLY] Path to the GCP service account JSON — the file, not
# its contents. Used only to build and manage the VM; the running app
# never touches GCP. Delete the key in the console once the VM is built.
GCP_SA_KEY_PATH=
GCP_ZONE=
GCP_INSTANCE_NAME=
# Path to the private key, not the key itself — never paste a key into
# a variable that gets echoed into logs.
VPS_SSH_KEY_PATH=
VPS_SSH_USER=
VPS_HOST=
# Where the desk lives on the VPS. DEPLOY.md names two paths; confirm
# which is live before deploying to the wrong one.
VPS_APP_DIR=/opt/saga-x-desk

# ── Mastery Signal webhook (Hermes/CTO polling) ─────────────
# A Flask receiver on the OLD server exposing cron, signal and state
# health for Alisya to poll. Auth is the X-CTO-Key header.
# Endpoints: /health (open) /status /api/cron /api/signals /api/state
MASTERY_WEBHOOK_URL=http://34.177.85.71:5002
CTO_API_KEY=
